# ===================================
# CONFIGURACIÓN DE PymeMap Backend
# ===================================
# Copia este archivo como .env y completa con tus valores reales

# ===================================
# BASE DE DATOS - MongoDB
# ===================================
# Conexión a MongoDB Atlas o instancia local
MONGO_URI=mongodb+srv://usuario:password@cluster.mongodb.net/
MONGO_DB_NAME=pymemap_db

# ===================================
# SEGURIDAD - JWT
# ===================================
# Clave secreta para firmar tokens JWT (CAMBIA ESTO EN PRODUCCIÓN)
# Genera una con: openssl rand -hex 32
JWT_SECRET_KEY=your-super-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ===================================
# CORS - Orígenes permitidos
# ===================================
# En desarrollo: http://localhost:8081
# En producción: https://tu-dominio-frontend.com
ALLOWED_ORIGINS=http://localhost:8081,https://pymemap-frontend.vercel.app

# ===================================
# SERVIDOR
# ===================================
# Puerto en el que correrá el servidor (Railway usa $PORT automáticamente)
PORT=8000

# ===================================
# ENTORNO
# ===================================
# development, production, staging
ENVIRONMENT=development

# ===================================
# EMAIL SERVICE (Resend)
# ===================================
# API Key de Resend para envío de emails
RESEND_API_KEY=your-resend-api-key-here
