<!doctype html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>Comentarios y Solicitudes de los Usuarios — PymeMap</title>

    <!-- Tipografía -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet">

    <!-- Estilos -->
    <link rel="stylesheet" href="css/estilo.css">

    <!-- Chart.js para el gráfico de satisfacción -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body>

<div class="app">
    <!-- Left Sidebar -->
    <aside class="sidebar" aria-label="Navegación principal">
        <div class="logo">
            <div class="mark">PM</div>
            <div>
                <div style="font-weight:700;font-size:16px">PymeMap</div>
                <div style="font-size:11px;color:var(--muted)">Panel Administrativo</div>
            </div>
        </div>

        <nav class="nav" aria-label="Secciones">
            <a href="index.html" class="active">💬 Comentarios</a>
            <a href="pedidos.html">📦 Pedidos</a>
            <a href="servicios.html">⚙️ Servicios</a>
            <a href="historial.html">📊 Historial</a>
            <a href="vision.html">👁️ Visión General</a>
        </nav>

        <div style="margin-top:auto;color:var(--muted);font-size:13px">
            <div style="border-top:1px solid var(--light-gray);padding-top:12px">
                Versión 1.0.0
            </div>
        </div>
    </aside>

    <!-- Main content -->
    <main class="main">
        <header class="header">
            <div class="biz">
                <img src="https://via.placeholder.com/48" alt="Business logo" style="width:48px;height:48px;border-radius:10px;border:1px solid var(--light-gray)">
                <div>
                    <div class="name">Mi Negocio</div>
                    <div style="font-size:13px;color:var(--muted)">Activo desde enero 2024</div>
                </div>
            </div>
            <div class="profile">
                <div>
                    <div style="font-weight:600;font-size:14px">Admin Usuario</div>
                    <div style="font-size:12px;color:var(--muted)">Administrador</div>
                </div>
                <div class="avatar">AU</div>
            </div>
        </header>

        <!-- Top metrics and content -->
        <section class="card">
            <div class="page-title">
                <h1>Comentarios y Solicitudes</h1>
                <p>Gestiona las reseñas y comentarios de tus clientes. Responde rápidamente para mejorar la satisfacción.</p>
            </div>

            <div class="metrics" style="margin-top:16px">
                <div class="metric">
                    <div class="num" id="total-comments">0</div>
                    <div class="label">Total comentarios</div>
                </div>
                <div class="metric">
                    <div class="num" id="avg-stars">0 ★</div>
                    <div class="label">Promedio estrellas</div>
                </div>
                <div class="metric">
                    <div class="num">
                        ⏱️
                        <span id="avgTimeSmall" style="font-size:14px;font-weight:600">N/A</span>
                    </div>
                    <div class="label">Tiempo promedio respuesta</div>
                </div>
            </div>
        </section>

        <div class="content">
            <!-- Left: Comments list -->
            <div class="card">
                <h2 style="margin:0 0 12px;font-size:16px;font-weight:700;color:var(--purple)">Lista de Comentarios</h2>
                
                <div class="controls">
                    <select class="select" id="statusFilter">
                        <option value="all">Todos los estados</option>
                        <option value="Pendiente">Pendiente</option>
                        <option value="En proceso">En proceso</option>
                        <option value="Resuelto">Resuelto</option>
                    </select>

                    <select class="select" id="ratingFilter">
                        <option value="all">Todas las estrellas</option>
                        <option value="5">5 estrellas</option>
                        <option value="4">4 estrellas</option>
                        <option value="3">3 estrellas</option>
                        <option value="2">2 estrellas</option>
                        <option value="1">1 estrella</option>
                    </select>

                    <input 
                        type="text" 
                        class="input" 
                        id="search" 
                        placeholder="Buscar en comentarios..." 
                        style="flex:1;min-width:200px"
                    />

                    <button class="btn" id="refresh-btn">🔄 Actualizar</button>
                    <button class="btn ghost" id="mark-all-resolved">✅ Marcar todos resueltos</button>

                    <select class="select" id="perPage" style="margin-left:auto">
                        <option value="5">5 por página</option>
                        <option value="10" selected>10 por página</option>
                        <option value="20">20 por página</option>
                        <option value="50">50 por página</option>
                    </select>
                </div>

                <div class="comments" id="commentsList">
                    <!-- Los comentarios se cargan dinámicamente aquí -->
                </div>

                <div class="pagination" id="pagination">
                    <!-- Los botones de paginación se cargan dinámicamente aquí -->
                </div>
            </div>

            <!-- Right: Chart and summary -->
            <div class="side-top">
                <div class="card">
                    <h3 style="margin:0 0 12px;font-size:14px;font-weight:700;color:var(--purple)">Distribución de Satisfacción</h3>
                    <canvas id="satisfactionChart" width="300" height="300"></canvas>
                </div>

                <div class="card">
                    <h3 style="margin:0 0 8px;font-size:14px;font-weight:700;color:var(--purple)">Ayuda Rápida</h3>
                    <ul style="margin:0;padding-left:18px;font-size:13px;color:var(--muted);line-height:1.6">
                        <li>Responde comentarios negativos primero.</li>
                        <li>Usa plantillas para respuestas comunes.</li>
                        <li>Marca como resuelto cuando termines.</li>
                    </ul>
                </div>
            </div>
        </div>
    </main>
</div>

<div class="toast" id="toast" role="status" aria-live="polite"></div>

<!-- JavaScript -->
<script src="js/main.js"></script>

</body>
</html>
        :root{
            --purple: #6C3BBF;
            --light-gray: #D9D9D9;
            --bg: #FFFFFF;
            --muted: #6b6b6b;
            --radius: 10px;
            --shadow: 0 6px 18px rgba(109,103,135,0.06);
            font-family: "Poppins", system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial;
        }
        *{box-sizing:border-box}
        html,body{height:100%}
        body{
            margin:0;
            background: #F7F7FB;
            color:#222;
            font-size:14px;
            -webkit-font-smoothing:antialiased;
            -moz-osx-font-smoothing:grayscale;
        }

        /* Layout */
        .app{
            display:flex;
            min-height:100vh;
        }
        .sidebar{
            width:260px;
            background:var(--bg);
            border-right:1px solid var(--light-gray);
            padding:18px;
            display:flex;
            flex-direction:column;
            gap:18px;
            box-shadow: var(--shadow);
        }
        .logo{
            display:flex;
            gap:12px;
            align-items:center;
            padding-bottom:6px;
            border-bottom:1px solid var(--light-gray);
        }
        .logo .mark{
            width:44px;height:44px;border-radius:10px;background:linear-gradient(135deg,var(--purple),#8a5edf);
            display:flex;align-items:center;justify-content:center;color:white;font-weight:700;font-size:18px;
        }
        .nav{
            margin-top:8px;
            display:flex;
            flex-direction:column;
            gap:6px;
        }
        .nav a{
            display:flex;
            align-items:center;
            gap:10px;
            padding:10px 12px;
            border-radius:10px;
            color:#333;
            text-decoration:none;
            border:1px solid transparent;
            font-weight:500;
        }
        .nav a.active{
            background:linear-gradient(90deg, rgba(108,59,191,0.08), rgba(108,59,191,0.03));
            color:var(--purple);
            border:1px solid var(--light-gray);
            box-shadow: inset 0 0 0 1px transparent;
        }
        .nav a:hover{background:#fbf7ff}

        /* Main content */
        .main{
            flex:1;
            padding:24px;
            display:flex;
            flex-direction:column;
            gap:18px;
        }
        .header{
            display:flex;
            justify-content:space-between;
            align-items:center;
            gap:16px;
        }
        .biz{
            display:flex;
            align-items:center;
            gap:12px;
        }
        .biz .name{font-weight:700;font-size:18px;color:var(--purple)}
        .profile{
            display:flex;align-items:center;gap:10px;
        }
        .profile .avatar{
            width:44px;height:44px;border-radius:50%;
            background:linear-gradient(135deg,#eee, #ddd);
            display:flex;align-items:center;justify-content:center;font-weight:600;color:#333;
            border:1px solid var(--light-gray);
        }
        .card{
            background:var(--bg);
            padding:18px;
            border-radius:var(--radius);
            border:1px solid var(--light-gray);
            box-shadow: var(--shadow);
        }

        /* Page title */
        .page-title{display:flex;flex-direction:column;gap:6px}
        .page-title h1{margin:0;color:var(--purple);font-size:20px}
        .page-title p{margin:0;color:var(--muted);font-size:13px}

        /* Top metrics */
        .metrics{
            display:flex;
            gap:16px;
            align-items:center;
        }
        .metric{
            min-width:160px;
            padding:12px;
            border-radius:10px;
            display:flex;
            flex-direction:column;
            gap:8px;
            background:linear-gradient(180deg, #fff, #fafaff);
            border:1px solid var(--light-gray);
        }
        .metric .num{font-weight:700;font-size:18px;color:var(--purple)}
        .metric .label{font-size:12px;color:var(--muted)}

        /* Layout for content below header */
        .content{
            display:grid;
            grid-template-columns: 1fr 360px;
            gap:18px;
            align-items:start;
        }

        /* Comments list */
        .controls{
            display:flex;
            gap:8px;
            align-items:center;
            margin-bottom:12px;
            flex-wrap:wrap;
        }
        .select, .input{
            padding:8px 10px;
            border-radius:10px;
            border:1px solid var(--light-gray);
            background:white;
            font-size:13px;
        }
        .btn{
            padding:8px 12px;
            border-radius:999px;
            border:1px solid transparent;
            background:var(--purple);
            color:white;
            font-weight:600;
            cursor:pointer;
            font-size:13px;
        }
        .btn.ghost{
            background:transparent;color:var(--purple);border:1px solid var(--light-gray);
        }

        .comments{
            display:flex;
            flex-direction:column;
            gap:12px;
            max-height:66vh;
            overflow:auto;
            padding-right:6px;
        }
        .comment{
            padding:12px;
            border-radius:8px;
            border:1px solid var(--light-gray);
            background:#fff;
            display:flex;
            gap:12px;
        }
        .comment .meta{
            width:72px;
            text-align:center;
            font-size:12px;
            color:var(--muted);
        }
        .comment .meta .user{
            font-weight:600;color:#333;font-size:13px;
        }
        .comment .body{
            flex:1;
            display:flex;
            flex-direction:column;
            gap:8px;
        }
        .comment .body .text{color:#333}
        .rating{display:inline-flex;gap:4px;align-items:center;color:#ffb400}
        .status{
            padding:6px 8px;
            border-radius:999px;
            font-size:12px;
            border:1px solid var(--light-gray);
            display:inline-block;
            background:#fafafa;
        }
        .comment .actions{
            display:flex;
            gap:8px;
            align-items:center;
            margin-top:6px;
        }
        .reply-box{
            margin-top:8px;
            display:flex;
            gap:8px;
            align-items:flex-start;
        }
        .reply-box textarea{
            flex:1;
            min-height:64px;
            resize:vertical;
            padding:8px;
            border-radius:8px;
            border:1px solid var(--light-gray);
            font-family:inherit;
            font-size:13px;
        }
        .small{font-size:13px;color:var(--muted)}

        /* Sidebar right */
        .side-top{display:flex;flex-direction:column;gap:12px}
        canvas{background:transparent}
        .pagination{
            display:flex;
            gap:8px;
            align-items:center;
            justify-content:center;
            margin-top:12px;
        }
        .page-btn{
            padding:8px 10px;border-radius:8px;border:1px solid var(--light-gray);background:white;cursor:pointer;
        }

        /* Toast */
        .toast{
            position:fixed;
            right:20px;
            bottom:20px;
            background:var(--purple);
            color:white;
            padding:12px 16px;
            border-radius:10px;
            box-shadow: 0 8px 24px rgba(108,59,191,0.18);
            display:none;
            z-index:9999;
        }

        /* Responsive */
        @media (max-width:940px){
            .content{grid-template-columns:1fr}
            .sidebar{display:none}
        }
    </style>
</head>
<body>

<div class="app">
    <!-- Left Sidebar -->
    <aside class="sidebar" aria-label="Navegación principal">
        <div class="logo">
            <div class="mark">PM</div>
            <div>
                <div style="font-weight:700">PymeMap</div>
                <div style="font-size:12px;color:var(--muted)">Panel de administrador</div>
            </div>
        </div>

        <nav class="nav" aria-label="Secciones">
            <a href="#" class="">Visión general</a>
            <a href="#" class="active">Comentarios y Reclamos</a>
            <a href="#">Historial de pagos</a>
            <a href="#">Mis servicios</a>
            <a href="#">Pedidos</a>
            <a href="#">Configuración de cuenta</a>
        </nav>

        <div style="margin-top:auto;color:var(--muted);font-size:13px">
            © PymeMap
        </div>
    </aside>

    <!-- Main content -->
    <main class="main">
        <header class="header">
            <div class="biz">
                <div class="page-title">
                    <h1>Comentarios y Solicitudes de los Usuarios</h1>
                    <p>Administra la interacción con tus clientes de manera rápida y eficiente. Responde a comentarios, reclamos y realiza un seguimiento detallado.</p>
                </div>
            </div>

            <div class="profile">
                <div style="text-align:right">
                    <div style="font-weight:700;color:#222">Mi Negocio S.A.</div>
                    <div style="font-size:12px;color:var(--muted)">Administrador</div>
                </div>
                <div class="avatar" aria-hidden="true">MN</div>
            </div>
        </header>

        <!-- Top metrics and content -->
        <section class="card">
            <div style="display:flex;justify-content:space-between;align-items:center;gap:16px;flex-wrap:wrap">
                <div style="display:flex;gap:12px;align-items:center">
                    <div class="metric">
                        <div class="num" id="avg-stars">4.3 ★</div>
                        <div class="label">Calificación promedio</div>
                    </div>
                    <div class="metric">
                        <div class="num" id="avg-time">12h 30m</div>
                        <div class="label">Tiempo promedio de respuesta</div>
                    </div>
                    <div class="metric">
                        <div class="num" id="total-comments">24</div>
                        <div class="label">Comentarios totales</div>
                    </div>
                </div>

                <div style="display:flex;gap:8px;align-items:center">
                    <button class="btn" id="new-filter-btn">Filtrar</button>
                    <button class="btn ghost" id="refresh-btn">Actualizar</button>
                </div>
            </div>
        </section>

        <div class="content">
            <!-- Left: comments list -->
            <section class="card" aria-labelledby="list-title">
                <h2 id="list-title" style="margin:0 0 12px 0;color:var(--purple)">Listado de interacciones</h2>

                <div class="controls" role="region" aria-label="Controles de filtrado">
                    <select id="statusFilter" class="select" aria-label="Filtrar por estado">
                        <option value="all">Todos los estados</option>
                        <option value="Pendiente">Pendientes</option>
                        <option value="En proceso">En proceso</option>
                        <option value="Resuelto">Resueltos</option>
                    </select>

                    <select id="ratingFilter" class="select" aria-label="Filtrar por calificación">
                        <option value="all">Todas las calificaciones</option>
                        <option value="5">5 estrellas</option>
                        <option value="4">4 estrellas</option>
                        <option value="3">3 estrellas</option>
                        <option value="2">2 estrellas</option>
                        <option value="1">1 estrella</option>
                    </select>

                    <input id="search" class="input" placeholder="Buscar por usuario o texto..." />

                    <div style="margin-left:auto" class="small">Mostrar por página:
                        <select id="perPage" class="select" style="margin-left:8px">
                            <option value="5">5</option>
                            <option value="10" selected>10</option>
                            <option value="20">20</option>
                        </select>
                    </div>
                </div>

                <div class="comments" id="commentsList" role="list" aria-live="polite">
                    <!-- Comentarios renderizados por JS -->
                </div>

                <div class="pagination" id="pagination">
                    <!-- Paginación -->
                </div>
            </section>

            <!-- Right: charts and quick stats -->
            <aside class="card" aria-label="Panel secundario">
                <div class="side-top">
                    <div>
                        <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px">
                            <div style="font-weight:700">Gráfico de satisfacción del cliente</div>
                            <div class="small">Últimos 30 días</div>
                        </div>
                        <canvas id="satisfactionChart" height="180" aria-label="Gráfico de barras de satisfacción"></canvas>
                    </div>

                    <div>
                        <div style="display:flex;justify-content:space-between;align-items:center">
                            <div style="font-weight:700">Tiempo promedio de respuesta</div>
                            <div class="small" id="avgTimeSmall">—</div>
                        </div>
                        <div style="margin-top:8px;color:var(--muted);font-size:13px">
                            Tiempo medio entre la publicación del comentario y la primera respuesta del vendedor.
                        </div>
                    </div>

                    <div style="display:flex;gap:8px;align-items:center;justify-content:space-between">
                        <div style="font-weight:700">Acciones rápidas</div>
                        <button class="btn ghost" id="mark-all-resolved">Marcar todo resuelto</button>
                    </div>
                </div>
            </aside>
        </div>
    </main>
</div>

<div class="toast" id="toast" role="status" aria-live="polite"></div>

<script>
    // Datos de ejemplo (sin errores de código). En producción estos vendrían de API.
    const comments = [
        { id:1,user:'Ana Ruiz', date:'2025-10-28T09:12:00Z', rating:5, text:'Excelente atención, producto como se describe. ¡Gracias!', status:'Pendiente', response:null, responseDate:null },
        { id:2,user:'Carlos M.', date:'2025-10-27T15:40:00Z', rating:2, text:'Producto llegó con retraso y sin embalaje adecuado.', status:'En proceso', response:'Hola Carlos, lo sentimos. Revisaremos el envío.', responseDate:'2025-10-27T17:00:00Z' },
        { id:3,user:'Lucía P', date:'2025-10-26T12:00:00Z', rating:1, text:'No recibí soporte después de la compra.', status:'Pendiente', response:null, responseDate:null },
        { id:4,user:'Diego L', date:'2025-10-24T08:20:00Z', rating:4, text:'Buen servicio, aunque la entrega tardó un poco.', status:'Resuelto', response:'Gracias por tu feedback, trabajaremos en mejorar tiempos.', responseDate:'2025-10-24T09:30:00Z' },
        { id:5,user:'María S', date:'2025-10-20T18:05:00Z', rating:3, text:'Producto correcto pero faltó un accesorio.', status:'Resuelto', response:'Ya te enviamos el accesorio faltante.', responseDate:'2025-10-21T10:00:00Z' },
        { id:6,user:'Paulo V', date:'2025-10-29T11:22:00Z', rating:5, text:'Recomendado, muy buen precio.', status:'Pendiente', response:null, responseDate:null },
        { id:7,user:'Sofia R', date:'2025-10-30T07:50:00Z', rating:4, text:'Atención rápida por chat.', status:'En proceso', response:null, responseDate:null },
        { id:8,user:'Miguel G', date:'2025-10-31T10:10:00Z', rating:2, text:'Falla técnica en el primer uso.', status:'Pendiente', response:null, responseDate:null },
        { id:9,user:'Valeria Q', date:'2025-10-18T09:00:00Z', rating:5, text:'Todo perfecto.', status:'Resuelto', response:'Gracias por tu reseña.', responseDate:'2025-10-18T09:10:00Z' },
        { id:10,user:'Roberto Z', date:'2025-10-15T14:44:00Z', rating:1, text:'Producto defectuoso, pido devolución.', status:'Pendiente', response:null, responseDate:null },
        // más items de ejemplo para paginación
    ];

    // UI state
    let state = {
        page: 1,
        perPage: 10,
        statusFilter: 'all',
        ratingFilter: 'all',
        search: ''
    };

    // Helpers
    const $ = id => document.getElementById(id);

    function formatDate(iso){
        const d = new Date(iso);
        return d.toLocaleString();
    }

    function renderStars(n){
        let out = '';
        for(let i=1;i<=5;i++){
            out += i<=n ? '★' : '☆';
        }
        return out;
    }

    function filteredComments(){
        return comments.filter(c => {
            if(state.statusFilter !== 'all' && c.status !== state.statusFilter) return false;
            if(state.ratingFilter !== 'all' && c.rating !== Number(state.ratingFilter)) return false;
            if(state.search){
                const s = state.search.toLowerCase();
                if(!c.user.toLowerCase().includes(s) && !c.text.toLowerCase().includes(s)) return false;
            }
            return true;
        }).sort((a,b)=> new Date(b.date) - new Date(a.date));
    }

    function paginate(list){
        const start = (state.page-1)*state.perPage;
        return list.slice(start, start + state.perPage);
    }

    function renderComments(){
        const list = filteredComments();
        const pageItems = paginate(list);
        const $list = $('commentsList');
        $list.innerHTML = '';
        if(pageItems.length === 0){
            $list.innerHTML = '<div class="small" style="padding:12px">No hay comentarios que coincidan.</div>';
        }
        pageItems.forEach(c=>{
            const div = document.createElement('div');
            div.className = 'comment';
            div.setAttribute('data-id', c.id);
            div.innerHTML = `
                <div class="meta" aria-hidden="true">
                    <div class="user">${c.user.split(' ')[0]}</div>
                    <div class="small">${formatDate(c.date)}</div>
                </div>
                <div class="body">
                    <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:8px">
                        <div>
                            <div class="rating" aria-hidden="true">${renderStars(c.rating)} <span class="small" style="margin-left:8px;color:var(--muted)">${c.rating}/5</span></div>
                            <div class="text">${escapeHtml(c.text)}</div>
                        </div>
                        <div style="text-align:right">
                            <div class="status">${c.status}</div>
                            <div class="small" style="margin-top:6px">${c.response ? 'Respondido' : 'Sin respuesta'}</div>
                        </div>
                    </div>

                    <div class="actions">
                        <button class="btn ghost" data-action="reply">Responder Comentario</button>
                        <button class="btn" data-action="resolve">Marcar como Resuelto</button>
                    </div>

                    ${c.response ? `<div style="margin-top:8px;padding:10px;border-radius:8px;border:1px dashed ${getComputedStyle(document.documentElement).getPropertyValue('--light-gray')};background:#fcfcfe">
                        <div style="font-weight:600;font-size:13px;color:#333">Respuesta</div>
                        <div style="margin-top:6px">${escapeHtml(c.response)}</div>
                        <div class="small" style="margin-top:8px;color:var(--muted)">Respondido: ${formatDate(c.responseDate)}</div>
                    </div>` : ''}
                </div>
            `;
            $list.appendChild(div);

            // Attach action listeners
            div.querySelectorAll('button').forEach(btn=>{
                btn.addEventListener('click', (e)=>{
                    const action = btn.getAttribute('data-action');
                    if(action === 'reply') openReplyBox(div, c);
                    if(action === 'resolve') markResolved(c.id);
                });
            });
        });

        renderPagination(list.length);
        updateSummary();
        updateChart();
    }

    function openReplyBox(container, comment){
        // prevent duplicate boxes
        if(container.querySelector('.reply-box')) return;

        const box = document.createElement('div');
        box.className = 'reply-box';
        box.innerHTML = `
            <textarea aria-label="Respuesta al comentario" placeholder="Escribe tu respuesta..."></textarea>
            <div style="display:flex;flex-direction:column;gap:8px">
                <button class="btn" data-action="send">Enviar</button>
                <button class="btn ghost" data-action="cancel">Cancelar</button>
            </div>
        `;
        container.querySelector('.body').appendChild(box);

        const ta = box.querySelector('textarea');
        ta.focus();

        box.querySelector('[data-action="cancel"]').addEventListener('click', ()=> box.remove());
        box.querySelector('[data-action="send"]').addEventListener('click', ()=>{
            const text = ta.value.trim();
            if(!text) {
                showToast('Escribe una respuesta antes de enviar.');
                return;
            }
            // Guardar respuesta (simulado)
            comment.response = text;
            comment.responseDate = new Date().toISOString();
            // Cambiar estado a "En proceso" si aún no está resuelto
            if(comment.status !== 'Resuelto') comment.status = 'En proceso';
            renderComments();
            showToast('Respuesta enviada al usuario (simulado).');
        });
    }

    function markResolved(id){
        const c = comments.find(x=>x.id===id);
        if(!c) return;
        c.status = 'Resuelto';
        // Si no tenía respuesta, genera mensaje automático de agradecimiento
        if(!c.response){
            c.response = `Hola ${c.user.split(' ')[0]}, gracias por tu comentario. Hemos marcado tu solicitud como resuelta. ¡Gracias por confiar en nosotros!`;
            c.responseDate = new Date().toISOString();
            // Simular envío de notificación al usuario
            showToast('Se marcó como resuelto y se envió un mensaje automático al usuario (simulado).');
        } else {
            showToast('Se marcó como resuelto.');
        }
        renderComments();
    }

    function markAllResolved(){
        comments.forEach(c=>{
            if(c.status !== 'Resuelto'){
                c.status = 'Resuelto';
                if(!c.response){
                    c.response = `Hola ${c.user.split(' ')[0]}, tu solicitud fue resuelta. Gracias por tu comentario.`;
                    c.responseDate = new Date().toISOString();
                }
            }
        });
        renderComments();
        showToast('Se marcaron todos los comentarios como resueltos (simulado).');
    }

    function renderPagination(total){
        const $p = $('pagination');
        $p.innerHTML = '';
        const pages = Math.max(1, Math.ceil(total / state.perPage));
        for(let i=1;i<=pages;i++){
            const btn = document.createElement('button');
            btn.className = 'page-btn';
            if(i===state.page) btn.style.background = 'linear-gradient(90deg, rgba(108,59,191,0.08), rgba(108,59,191,0.03))';
            btn.textContent = i;
            btn.addEventListener('click', ()=> {
                state.page = i;
                renderComments();
            });
            $p.appendChild(btn);
        }
    }

    // Chart
    let chart;
    function updateChart(){
        const counts = {positive:0, neutral:0, negative:0};
        comments.forEach(c=>{
            if(c.rating >= 4) counts.positive++;
            else if(c.rating === 3) counts.neutral++;
            else counts.negative++;
        });

        const ctx = document.getElementById('satisfactionChart').getContext('2d');
        if(chart) chart.destroy();
        chart = new Chart(ctx, {
            type: 'bar',
            data: {
                labels: ['Positivos','Neutrales','Negativos'],
                datasets: [{
                    label: 'Comentarios',
                    data: [counts.positive, counts.neutral, counts.negative],
                    backgroundColor: ['#7f5cff','#c6bdf7','#ff7b7b']
                }]
            },
            options: {
                maintainAspectRatio:false,
                plugins:{legend:{display:false}},
                scales:{
                    y:{beginAtZero:true,grid:{color:'#f2f2f2'}}
                }
            }
        });
    }

    // Resumen
    function updateSummary(){
        const total = comments.length;
        $('total-comments').textContent = total;
        // avg stars
        const avg = (comments.reduce((s,c)=>s+c.rating,0) / comments.length) || 0;
        $('avg-stars').textContent = avg.toFixed(1) + ' ★';
        // avg response time: consider only those with responseDate
        const responded = comments.filter(c => c.responseDate);
        if(responded.length){
            const diffs = responded.map(c => {
                return (new Date(c.responseDate) - new Date(c.date)) / (1000*60*60); // hours
            });
            const avgHours = diffs.reduce((a,b)=>a+b,0) / diffs.length;
            const hours = Math.floor(avgHours);
            const mins = Math.round((avgHours - hours) * 60);
            $('avg-time').textContent = `${hours}h ${mins}m`;
            $('avgTimeSmall').textContent = `${hours}h ${mins}m`;
        } else {
            $('avg-time').textContent = '—';
            $('avgTimeSmall').textContent = '—';
        }
    }

    // Toast
    let toastTimeout;
    function showToast(msg){
        const t = $('toast');
        t.textContent = msg;
        t.style.display = 'block';
        clearTimeout(toastTimeout);
        toastTimeout = setTimeout(()=> t.style.display='none', 3600);
    }

    // Utility to escape HTML
    function escapeHtml(str){
        return String(str)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#39;')
            .replace(/\n/g, '<br>');
    }

    // Event bindings
    document.addEventListener('DOMContentLoaded', ()=>{
        // init UI values
        $('statusFilter').addEventListener('change', e=>{
            state.statusFilter = e.target.value;
            state.page = 1;
            renderComments();
        });
        $('ratingFilter').addEventListener('change', e=>{
            state.ratingFilter = e.target.value;
            state.page = 1;
            renderComments();
        });
        $('search').addEventListener('input', e=>{
            state.search = e.target.value;
            state.page = 1;
            renderComments();
        });
        $('perPage').addEventListener('change', e=>{
            state.perPage = Number(e.target.value);
            state.page = 1;
            renderComments();
        });
        $('refresh-btn').addEventListener('click', ()=> {
            showToast('Datos actualizados (simulado).');
            renderComments();
        });
        $('mark-all-resolved').addEventListener('click', ()=> {
            if(confirm('¿Marcar todos los comentarios no resueltos como resueltos?')) {
                markAllResolved();
            }
        });

        // Initial render
        renderComments();
        updateChart();
    });
</script>
</body>
</html></select></div></section></div>